{
  "expo": {
    "name": "SyndeoCare",
    "slug": "syndeocare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "syndeocare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": { "policy": "appVersion" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.syndeocare.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "نستخدم الكاميرا لالتقاط صورة الملف الشخصي أو الوثائق المطلوبة للتوثيق.",
        "NSPhotoLibraryUsageDescription": "نستخدم معرض الصور لاختيار صورة الملف الشخصي أو الوثائق المطلوبة للتوثيق."
      }
    },
    "android": {
      "package": "app.syndeocare.mobile",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F6F8FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نستخدم معرض الصور لاختيار صورة الملف الشخصي أو الوثائق المطلوبة للتوثيق.",
          "cameraPermission": "نستخدم الكاميرا لالتقاط صورة الملف الشخصي أو الوثائق المطلوبة للتوثيق."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "https://c--d0e2dae3-47ec-4809-aaa2-34d5b738fb9b-prod.lovable.cloud",
      "supabasePublishableKey": "sb_publishable_nLkZX1a7gWCIR5Q97CkAuQ_wBfSoJLC",
      "webUrl": "https://medmatch-plus.lovable.app",
      "eas": {
        "projectId": ""
      }
    }
  }
}
